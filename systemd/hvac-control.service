[Unit]
Description=Duplex evaporative cooler controller
Wants=revpipyload.service
After=revpipyload.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/evap_cooler_duplex_control
Environment=PYTHONUNBUFFERED=1
Environment=HVAC_LOG_DIR=/home/pi
ExecStart=/usr/bin/python3 -u /home/pi/evap_cooler_duplex_control/hvac_control.py
ExecStopPost=/usr/local/sbin/hvac-safe-outputs
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hvac-control

[Install]
WantedBy=multi-user.target
